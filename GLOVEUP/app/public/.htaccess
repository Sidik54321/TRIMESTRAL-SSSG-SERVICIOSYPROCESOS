# ──────────────────────────────────────────────────────────────────
# Front controller: cualquier URL que no corresponda a un fichero
# real se envía a index.php, que decide qué vista renderizar.
# ──────────────────────────────────────────────────────────────────

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Los ficheros y directorios existentes (CSS, JS, imágenes, /legacy)
    # se sirven tal cual, sin pasar por PHP.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demás lo resuelve el router de la SPA.
    RewriteRule ^ index.php [L]
</IfModule>

# ── Cabeceras de seguridad ────────────────────────────────────────
# Equivalentes a las que ya aplica la API en server/src/app.js.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # app.js y tailwind.css se sirven con el mismo nombre en cada
    # despliegue (no hay paso de build que les añada un hash), así que
    # cachearlos por adelantado es peligroso: un cambio de código podría
    # no notarse en un navegador que ya los tuviera guardados. Se fuerza
    # a revalidar siempre contra el servidor (sigue siendo barato: sin
    # cambios responde 304 gracias al ETag/Last-Modified) en vez de
    # confiar en la caché "heurística" del navegador.
    <FilesMatch "\.(css|js)$">
        Header always set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# ── Caché de estáticos que sí son seguros de guardar ──────────────
# Las imágenes y vídeos no cambian de contenido bajo el mismo nombre.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType video/mp4 "access plus 6 months"
</IfModule>

DirectoryIndex index.php
