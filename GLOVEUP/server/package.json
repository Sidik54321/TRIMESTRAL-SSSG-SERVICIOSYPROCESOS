{
    "name": "gloveup-server",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "node --env-file=.env src/index.js",
        "dev": "nodemon --exec \"node --env-file=.env\" src/index.js",
        "seed:boxeadores": "node --env-file=.env src/seed/seedBoxeadores.js",
        "seed:demo": "node --env-file=.env src/seed/seedBoxeadores.js --demo",
        "seed": "node src/seed/seedBoxeadores.js --demo",
        "clear-db": "node --env-file=.env clear-db.js",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "express": "^4.18.2",
        "mongoose": "^7.6.0"
    },
    "devDependencies": {
        "mongodb-memory-server": "^11.2.0",
        "nodemon": "^3.0.2",
        "supertest": "^7.2.2",
        "vitest": "^4.1.7"
    }
}
